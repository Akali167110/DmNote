{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "packages/editor/src/types/**/*.ts",
    "packages/editor/src/renderer/editor/model/**/*.ts",
    "packages/editor/src/renderer/editor/runtime/coordinator/editorCoordinator.ts",
    "packages/editor/src/renderer/editor/runtime/projection/**/*.ts",
    "packages/editor/src/renderer/editor/runtime/geometry/batchGeometryPlan.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/editor/src/**/*.test.ts",
    "packages/editor/src/**/*.test.tsx",
    "packages/*/dist"
  ]
}
