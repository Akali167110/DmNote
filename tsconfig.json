{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@components/*": ["./packages/editor/src/renderer/components/*"],
      "@styles/*": ["./packages/editor/src/renderer/styles/*"],
      "@windows/*": ["./src/renderer/windows/*"],
      "@hooks/*": ["./packages/editor/src/renderer/hooks/*"],
      "@api/*": ["./packages/editor/src/renderer/api/*"],
      "@assets/*": ["./packages/editor/src/renderer/assets/*"],
      "@utils/*": ["./packages/editor/src/renderer/utils/*"],
      "@stores/*": ["./packages/editor/src/renderer/stores/*"],
      "@constants/*": ["./packages/editor/src/renderer/constants/*"],
      "@contexts/*": ["./packages/editor/src/renderer/contexts/*"],
      "@plugins/*": ["./packages/editor/src/renderer/plugins/*"],
      "@config/*": ["./packages/editor/src/renderer/config/*"],
      "@src/*": ["./packages/editor/src/*"],
      "@dmnote/editor/*": ["./packages/editor/src/*"],
      "@dmnote/ipc-shim": ["./packages/ipc-shim/src/index.ts"],
      "@app/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "packages/editor/src/**/*"],
  "exclude": ["node_modules", "dist", "packages/*/dist"]
}
