{
  "name": "@dmnote/editor",
  "version": "0.1.0",
  "description": "Shared DM Note editor, rendering and plugin runtime",
  "license": "GPL-3.0-only",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "exports": {
    "./editor": {
      "types": "./dist/types/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./overlay": {
      "types": "./dist/types/overlay.d.ts",
      "import": "./dist/overlay.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./install": {
      "types": "./dist/types/install.d.ts",
      "import": "./dist/install.js"
    },
    "./model": {
      "types": "./dist/types/model.d.ts",
      "import": "./dist/model.js"
    },
    "./plugins": {
      "types": "./dist/types/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./style.css": "./dist/editor.css",
    "./globals": {
      "types": "./dist/types/types/electron.d.ts"
    },
    "./grid": {
      "types": "./dist/types/grid.d.ts",
      "import": "./dist/grid.js"
    },
    "./toolbar": {
      "types": "./dist/types/toolbar.d.ts",
      "import": "./dist/toolbar.js"
    },
    "./panel-host": {
      "types": "./dist/types/panel-host.d.ts",
      "import": "./dist/panel-host.js"
    },
    "./dialogs": {
      "types": "./dist/types/dialogs.d.ts",
      "import": "./dist/dialogs.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.43.10",
    "@floating-ui/react": "^0.27.20",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "~2.11.0",
    "htm": "^3.1.1",
    "lenis": "^1.3.26",
    "ogl": "^1.0.11",
    "three": "^0.185.1",
    "use-sync-external-store": "^1.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15",
    "@preact/signals-react": "^3.12.0"
  }
